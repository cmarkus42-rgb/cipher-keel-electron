{
  "name": "cipher-keel-electron",
  "version": "0.1.0",
  "description": "cipher keel — tmux multiplexer around official coding CLIs",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "cipher",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sqlite-vec": "^0.1.9"
  },
  "build": {
    "appId": "dev.cipher.keel",
    "productName": "cipher keel",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
