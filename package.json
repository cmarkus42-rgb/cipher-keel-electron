{
  "name": "cipher-keel-electron",
  "version": "0.1.0",
  "description": "cipher keel — tmux multiplexer around official coding CLIs",
  "main": "dist/main/index.js",
  "scripts": {
    "postinstall": "patch-package",
    "rebuild-native": "electron-rebuild --build-from-source --force && npm rebuild better-sqlite3",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "electron",
    "tmux",
    "claude-code",
    "knowledge-graph",
    "mcp",
    "ai-agents",
    "coding-agent"
  ],
  "author": "Christian Markus",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "gray-matter": "^4.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sqlite-vec": "^0.1.9",
    "ulidx": "^2.4.1"
  },
  "overrides": {
    "@xterm/addon-canvas": {
      "@xterm/xterm": "$@xterm/xterm"
    }
  },
  "build": {
    "appId": "dev.cipher.keel",
    "productName": "cipher keel",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
