{
  "name": "cipher-keel-electron",
  "version": "0.1.0",
  "description": "cipher keel — tmux multiplexer around official coding CLIs",
  "main": "dist/main/index.js",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "rebuild-native": "electron-rebuild --build-from-source --force && npm rebuild better-sqlite3",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b --noEmit --force",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64",
    "dist": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64",
    "smoke:packaged": "node scripts/smoke-packaged.mjs"
  },
  "keywords": [
    "electron",
    "tmux",
    "claude-code",
    "knowledge-graph",
    "mcp",
    "ai-agents",
    "coding-agent"
  ],
  "author": "Christian Markus",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.2.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "gray-matter": "^4.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sqlite-vec": "^0.1.9",
    "ulidx": "^2.4.1"
  },
  "overrides": {
    "@xterm/addon-canvas": {
      "@xterm/xterm": "$@xterm/xterm"
    }
  },
  "build": {
    "appId": "dev.cipher.keel",
    "productName": "cipher keel",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "cipher keel ${version}",
      "contents": [
        { "x": 140, "y": 200, "type": "file" },
        { "x": 400, "y": 200, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
